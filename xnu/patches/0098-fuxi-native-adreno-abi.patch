+ fg_scanout_writable = 0;
+ if (!fg_scanout_write(FG_SCAN_CTL+0x1c, 1)) return fg_scanout_stop("start transfer");
+ __asm__ volatile("dsb sy" ::: "memory");
+ fg_scanout_after = rsr("cntpct_el0") + rsr("cntfrq_el0")*FG_SCAN_DRAIN_US/1000000;
